model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensao

	annotation PBI_QueryGroupOrder = 0

queryGroup Fato

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["dCidades","dClientes","dPagamentos","dProdutos","dUnidades","dStatus","dVendedores","fVendas","fMetas","dCaminho","fCaminho","fCaminhoMetas","dCalendario","Medidas"]

ref table dClientes
ref table dPagamentos
ref table dProdutos
ref table dUnidades
ref table dStatus
ref table dVendedores
ref table fVendas
ref table fMetas
ref table dCalendario
ref table Medidas
ref table tbTooltipGerentes

ref cultureInfo en-US

