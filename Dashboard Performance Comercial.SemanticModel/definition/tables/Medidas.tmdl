	measure 'Produtos sem Vendas' = ```
			
			
			VAR vProdutosVendidos = 
			    VALUES(fVendas[Id Produto])
			
			VAR vTodosProdutos = 
			    VALUES(dProdutos[Id Produto])
			
			VAR vResultado = 
			    EXCEPT(
			        vTodosProdutos,
			        vProdutosVendidos
			    )
			
			RETURN
			
			COUNTROWS(
			    vResultado
			)
			
			
			```
		formatString: 0
		displayFolder: 02.Valores Totais
		lineageTag: 8513f24d-9f3e-4a62-901c-01fc725fc4eb

	measure 'Produtos recorrentes month' = ```
			
			
			VAR vProdutosAtuais = 
			    VALUES(fVendas[Id Produto])
			
			VAR vProdutosMesAnt = 
			    CALCULATETABLE(
			        VALUES(fVendas[Id Produto]),
			        PREVIOUSMONTH(
			            dCalendario[Data]
			        )
			    )
			
			VAR vResultado = 
			    INTERSECT(
			        vProdutosAtuais,
			        vProdutosMesAnt
			    )
			
			RETURN
			
			vResultado
			```
		formatString: 0
		displayFolder: 02.Valores Totais
		lineageTag: 64ebc1a8-b2fc-41b7-a06d-62c881c732de

