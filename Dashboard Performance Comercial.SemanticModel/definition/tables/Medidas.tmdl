	measure '% Margem Contribuição Total' =
			
			VAR FaturamentoFixo =
			CALCULATE(
			    [Faturamento],
			    ALLSELECTED(fVendas)
			)
			
			RETURN
			
			DIVIDE(
			    [Faturamento],
			    FaturamentoFixo,
			    "--"
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01.Percentagens\Margem
		lineageTag: ca54d2a3-6d98-4526-87d6-b01bc7ac58fc

	measure '% Margem Contribuição Vendedores' =
			
			VAR FaturamentoFixo =
			CALCULATE(
			    [Faturamento],
			    ALLSELECTED(dVendedores[Vendedor])
			)
			
			RETURN
			
			DIVIDE(
			    [Faturamento],
			    FaturamentoFixo,
			    "--"
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01.Percentagens\Margem
