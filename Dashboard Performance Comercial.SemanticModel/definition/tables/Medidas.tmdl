	measure 'Eixo Y EvolucaoFaturamento' = ```
			
			
			VAR vTabela = 
			ALLSELECTED(
			    dCalendario[Mes Abreviado],
			    dCalendario[Mês]
			)
			
			VAR vMaiorValor = 
			MAXX(
			    vTabela,
			    [Faturamento]
			)
			
			RETURN
			
			vMaiorValor * 1.3
			```
