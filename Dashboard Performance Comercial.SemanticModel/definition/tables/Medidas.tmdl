	measure Faturamento =
			
			
			
			
			CALCULATE(
			    SUMX(
			        fVendas,
			        fVendas[Valor Unit] * fVendas[Qtde]
			    ),
			    dStatus[Id Status] = 1
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 02.Valores Totais
		lineageTag: 3f31b7e4-3202-4ee2-a8ea-400b6eac08ca

