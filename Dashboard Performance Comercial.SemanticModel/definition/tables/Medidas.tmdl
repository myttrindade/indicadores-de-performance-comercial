	measure 'Rank Vendedor Faturamento' =
			
			RANK(
			    DENSE,
			    ALLSELECTED(dVendedores[Vendedor]),
			    ORDERBY(
			        [Faturamento],     DESC,
			        [Resultado]  ,     DESC,   -- 1º Critério de desempate
			        [% Margem Contribuição]     ,     DESC,   -- 2º Critério de desempate
			        dVendedores[Vendedor], ASC     -- 3º Critério de desempate
			    )
			)
		formatString: 0
		displayFolder: 02.Valores Totais
		lineageTag: 97784c8d-49f8-4bf0-9d87-fb2fdfdaa79c

	measure 'Rank Vendedor Top5' =
			
			CALCULATE(
			    [Faturamento],
			    KEEPFILTERS(
			        TOPN(
			            5,
			            ALL(dVendedores),
			            [Faturamento]
			        )
			    )
			)
		displayFolder: 02.Valores Totais
		lineageTag: cfd7708a-746d-4dca-820b-e8d32376f701

