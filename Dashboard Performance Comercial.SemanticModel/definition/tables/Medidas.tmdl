	measure 'Faturamento >70mi por Vendedor' =
			
			SUMX(
			    VALUES(
			        dCalendario[Ano]
			    ),
			    CALCULATE(
			        [Faturamento],
			        FILTER(
			            VALUES(
			                dVendedores[Id Vendedor]
			            ),
			            [Faturamento] > 70000000
			        )
			    )
			)
		displayFolder: 02.Valores Totais
		lineageTag: 2fc90774-c84d-4821-bc44-c80db5dd662c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Faturamento LY' = ```
			
			
			VAR vUltimaDataVenda = 
			CALCULATE(
			    MAX(fVendas[Data Pedido]),
			    ALLSELECTED(
			        dCalendario
			    )
			)
			
			VAR vTabela = 
			FILTER(
			    VALUES(dCalendario[Data]),
			    dCalendario[Data] <= vUltimaDataVenda
			)
			
			RETURN
			    
			    
			    CALCULATE(
			        [Faturamento],
			        SAMEPERIODLASTYEAR(
			            vTabela
			        )
			    )
			```
		displayFolder: 03.Valores Temporais\Faturamento
		lineageTag: 4a2fba44-12a3-4202-a9a6-b3a4044aca29

		formatStringDefinition =
				VAR vValor = [Faturamento LY]
				
				RETURN
				SWITCH(
				    TRUE(),
				    ABS(vValor) >= 1E9, "0,,,.00 Bi",
				    ABS(vValor) >= 1E6, "0,,.00 Mi",
				    ABS(vValor) >= 1E3, "0,.00 K",
				    "0"
				)

	measure '% Faturamento YoY' =
			
			DIVIDE(
			    [Faturamento] - [Faturamento LY],
			    [Faturamento LY]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01.Percentagens\Faturamento
		lineageTag: c7b5cd62-c80d-442c-97df-a85ad02d9e73

	measure 'Resultado LY' = ```
			
			
			VAR vUltimaDataVenda = 
			CALCULATE(
			    MAX(fVendas[Data Pedido]),
			    ALLSELECTED(
			        dCalendario
			    )
			)
			
			VAR vTabela = 
			FILTER(
			    VALUES(dCalendario[Data]),
			    dCalendario[Data] <= vUltimaDataVenda
			)
			
			RETURN
			CALCULATE(
			    [Resultado],
			    DATEADD(
			        vTabela,
			        -1,
			        YEAR
