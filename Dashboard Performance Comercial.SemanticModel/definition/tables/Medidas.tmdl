	measure 'Faturamento Formatado Texto' = ```
			
			
			VAR vValor = [Faturamento]
			
			RETURN
			
			SWITCH(
			    TRUE(),
			    ABS(vValor) >= 1E9, -- 1000000000
			    FORMAT(
			        vValor,
			        "0,,,.00 Bi" -- Cada virgula divide o valor por 1000
			    ),
			    ABS(vValor) >= 1E6, --  1000000
			    FORMAT(
			        vValor,
			        "0,,.00 Mi" -- Cada virgula divide o valor por 1000
			    ),
			    ABS(vValor) >= 1E3, -- 1000
			    FORMAT(
			        vValor,
			        "0,.00 K" -- Cada virgula divide o valor por 1000
			    ),
			    FORMAT(
			        vValor,
			        "0" 
			    )
			)
			```
