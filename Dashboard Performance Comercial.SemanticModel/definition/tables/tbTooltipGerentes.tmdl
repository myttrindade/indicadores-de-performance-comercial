		isNameInferred
		sourceColumn: [ID]

		annotation SummarizationSetBy = Automatic

	partition tbTooltipGerentes = calculated
		mode: import
		source =
				
				
				DATATABLE(
				    "Medidas", STRING,
				    "ID", INTEGER,
				    {
				        {"Anterior", 1},
				        {"Atual", 2},
				        {"", 3}
				    }
				)

	annotation PBI_Id = 76106fadefe2424cbaed9f8508ded390

