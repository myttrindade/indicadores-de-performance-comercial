{
  "name": "Estudos - Performance Comercial",
  "textClasses": {
    "label": {
      "fontSize": 11,
      "color": "#13072F"
    },
    "title": {
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 14,
      "color": "#13072F"
    },
    "callout": {
      "color": "#13072F"
    },
    "header": {
      "color": "#13072F"
    }
  },
  "dataColors": [
    "#13072F",
    "#9C80BE",
    "#D1783C",
    "#CDC0D5",
    "#F2E8FA",
    "#14A962",
    "#CB9B3E",
    "#AD3F6B"
  ],
  "bad": "#AD3F6B",
  "neutral": "#CB9B3E",
  "good": "#14A962",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "transparency": 0,
            "color": {
              "solid": {
                "color": "#FAFAFA"
              }
            }
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#13072F"
              }
            }
          }
        ],
        "visualTooltip": [
          {
            "themedTitleFontColor": {
              "solid": {
                "color": "#13072F"
              }
            },
            "themedValueFontColor": {
              "solid": {
                "color": "#13072F"
              }
            },
            "actionFontColor": {
              "solid": {
                "color": "#13072F"
              }
            }
          }
        ],
        "visualHeaderTooltip": [
          {
            "themedTitleFontColor": {
              "solid": {
                "color": "#13072F"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#CDC0D5"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  },
  "backgroundLight": "#13072F",
  "background": "#F2E8FA",
  "backgroundNeutral": "#F2E8FA",
  "foregroundNeutralSecondary": "#13072F"
}