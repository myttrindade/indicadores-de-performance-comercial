{
  "name": "Estudos - Performance Comercial",
  "textClasses": {
    "label": {
      "fontSize": 11,
      "color": "#1B0F3A"
    },
    "title": {
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 14,
      "color": "#1B0F3A"
    },
    "callout": {
      "color": "#1B0F3A"
    },
    "header": {
      "color": "#1B0F3A"
    }
  },
  "dataColors": [
    "#5E34F7",
    "#8D6BFF",
    "#3A1BA8",
    "#B8A4FF",
    "#E1DBFF",
    "#14A962",
    "#CB9B3E",
    "#AD3F6B"
  ],
  "bad": "#AD3F6B",
  "neutral": "#CB9B3E",
  "good": "#14A962",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "transparency": 0,
            "color": {
              "solid": {
                "color": "#FAFAFA"
              }
            }
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#1B0F3A"
              }
            }
          }
        ],
        "visualTooltip": [
          {
            "themedTitleFontColor": {
              "solid": {
                "color": "#1B0F3A"
              }
            },
            "themedValueFontColor": {
              "solid": {
                "color": "#1B0F3A"
              }
            },
            "actionFontColor": {
              "solid": {
                "color": "#1B0F3A"
              }
            }
          }
        ],
        "visualHeaderTooltip": [
          {
            "themedTitleFontColor": {
              "solid": {
                "color": "#1B0F3A"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#C9C2EA"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  },
  "backgroundLight": "#1B0F3A",
  "background": "#F1EEFF",
  "backgroundNeutral": "#F1EEFF",
  "foregroundNeutralSecondary": "#1B0F3A"
}